[Unit]
Description=Autopoiesis Chromium kiosk
PartOf=autopoiesis.target
After=graphical.target autopoiesis-setup.service
Wants=autopoiesis-setup.service

[Service]
Type=simple
User=frame
Group=frame
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/frame/.Xauthority
Environment=AUTOPOIESIS_LAUNCH_URL=http://localhost:3030/launch
Environment=AUTOPOIESIS_CHROMIUM_PROFILE=/var/lib/autopoiesis-os/chromium
ExecStart=/opt/autopoiesis-os/app/scripts/start-kiosk.sh
Restart=always
RestartSec=5

# Security hardening (kiosk: Chromium needs broader filesystem access)
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=graphical.target
