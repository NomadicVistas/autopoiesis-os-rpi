[Unit]
Description=Autopoiesis artwork cache refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=frame
Group=frame
Environment=AUTOPOIESIS_DATA_DIR=/var/lib/autopoiesis-os
Environment=AUTOPOIESIS_CACHE_DIR=/var/lib/autopoiesis-os/cache
Environment=AUTOPOIESIS_LOG_DIR=/var/log/autopoiesis-os
ExecStartPre=/opt/autopoiesis-os/app/scripts/feed-sync.sh
ExecStart=/opt/autopoiesis-os/app/scripts/cache-artworks.sh

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/autopoiesis-os /var/lib/autopoiesis-os/cache /var/log/autopoiesis-os
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
