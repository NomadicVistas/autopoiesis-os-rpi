[Unit]
Description=Autopoiesis release updater
PartOf=autopoiesis.target
After=network-online.target autopoiesis-setup.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=AUTOPOIESIS_APP_DIR=/opt/autopoiesis-os/app
Environment=AUTOPOIESIS_INSTALL_DIR=/opt/autopoiesis-os
Environment=AUTOPOIESIS_DATA_DIR=/var/lib/autopoiesis-os
Environment=AUTOPOIESIS_LOG_DIR=/var/log/autopoiesis-os
Environment=AUTOPOIESIS_USER=frame
ExecStart=/opt/autopoiesis-os/app/scripts/check-release-update.sh

# Security hardening (root service: maximum restriction)
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/autopoiesis-os /var/log/autopoiesis-os /opt/autopoiesis-os
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
