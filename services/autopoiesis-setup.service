[Unit]
Description=Autopoiesis local setup and launcher UI
After=network.target

[Service]
Type=simple
User=frame
Group=frame
Environment=AUTOPOIESIS_DATA_DIR=/var/lib/autopoiesis-os
Environment=AUTOPOIESIS_LOG_DIR=/var/log/autopoiesis-os
Environment=AUTOPOIESIS_INSTALL_DIR=/opt/autopoiesis-os
Environment=AUTOPOIESIS_APP_DIR=/opt/autopoiesis-os/app
Environment=AUTOPOIESIS_PORT=3030
WorkingDirectory=/opt/autopoiesis-os/app/local-ui
ExecStart=/opt/autopoiesis-os/app/scripts/start-setup.sh
Restart=always
RestartSec=3

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/autopoiesis-os /var/log/autopoiesis-os
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=graphical.target
