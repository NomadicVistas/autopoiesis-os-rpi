[Unit]
Description=Autopoiesis heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=frame
Group=frame
Environment=AUTOPOIESIS_DATA_DIR=/var/lib/autopoiesis-os
Environment=AUTOPOIESIS_LOG_DIR=/var/log/autopoiesis-os
ExecStart=/opt/autopoiesis-os/app/scripts/heartbeat.sh
